# Copy to .env (gitignored) and fill in. Only orreryd reads these -- the CLI,
# the frontend and `make check` do not need any of them, which is the point:
# the app works with this server down. BACKEND.md 1.

# Required. orreryd refuses to start without it, rather than starting and
# failing on the first request.
DATABASE_URL=postgres://orrery:CHANGEME@localhost:5432/orrery

ORRERY_ADDR=:8080

# dev | prod. dev allows any Origin so a vite port change does not break CORS;
# prod requires ORRERY_CORS_ORIGINS and refuses to start without it.
ORRERY_ENV=dev

# Exact origins, comma separated. Never "*" -- this API writes rows.
ORRERY_CORS_ORIGINS=

# How long one generation may run. Hitting it is NOT an error: the trace comes
# back marked truncated, which for an exponential algorithm is the lesson.
ORRERY_TRACE_DEADLINE=5s
