# Copy to .env (gitignored) and fill in. Only orreryd reads these -- the CLI,
# the frontend and `make check` do not need any of them, which is the point:
# the app works with this server down. BACKEND.md 1.

# Required. orreryd refuses to start without it, rather than starting and
# failing on the first request.
DATABASE_URL=postgres://orrery:CHANGEME@localhost:5432/orrery

ORRERY_ADDR=:8080

# dev | prod. dev allows any Origin so a vite port change does not break CORS;
# prod requires ORRERY_CORS_ORIGINS and refuses to start without it.
ORRERY_ENV=dev

# Exact origins, comma separated. Never "*" -- this API writes rows.
ORRERY_CORS_ORIGINS=

# How long one generation may run. Hitting it is NOT an error: the trace comes
# back marked truncated, which for an exponential algorithm is the lesson.
ORRERY_TRACE_DEADLINE=5s

# The CIDRs of your own proxies, comma separated. A bare address is taken as a
# single host.
#
# EMPTY MEANS X-Forwarded-For IS IGNORED ENTIRELY, and that is the safe default:
# a server reached directly sees the real peer, and honouring a forwarded header
# nobody stripped means honouring one anybody can send. Set this only when there
# really is a proxy in front, and set it to that proxy -- the rate limiter walks
# the header from the RIGHT and stops at the first hop outside this list, which
# is the last address an attacker cannot forge. BACKEND.md 4.
ORRERY_TRUSTED_PROXIES=

# Salts the hash that goes in the request log in place of the IP. Leave it unset
# and a random salt is generated per process, which makes one log file
# correlatable within a run and useless afterwards -- which is as much as this
# project has any business retaining. Set it only if correlation ACROSS restarts
# is genuinely wanted.
ORRERY_IP_SALT=
